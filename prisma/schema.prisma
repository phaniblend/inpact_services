// Real production schema for the 4 live products' DB tasks (SentinelPOS, MiniERP, RouteMatrix,
// BatchCraft) — user directive, 2026-09-13: match each product-catalog spec's literal enterprise
// architecture, including real Postgres. Lives in the `inpact_products` schema of the same Postgres
// server Mattermost already uses on Railway (PRODUCTS_DATABASE_URL = ${{Postgres.DATABASE_URL}}
// ?schema=inpact_products) — a real, separate namespace, never touching Mattermost's own tables.
//
// One schema.prisma file for all 4 products (they're one Node deployment, one database), so every
// model is prefixed with its product's two-letter code (Sp/Me/Rm/Bc) to avoid name collisions —
// e.g. SentinelPOS's spec calls its own model "Tenant", but so does every other product's spec, and
// Prisma model names must be unique within one schema file.
//
// Migrations are hand-authored (prisma/migrations/*/migration.sql), not generated by `prisma
// migrate dev` — that command needs a live, reachable connection (including a shadow DB) to diff
// against, and PRODUCTS_DATABASE_URL is a Railway-private address unreachable from outside Railway's
// own network, same constraint documented on ONEDEV_INTERNAL_URL. `prisma migrate deploy` (added as
// this repo's `prestart` script, so npm runs it automatically before `npm start`) applies them
// instead — that command needs no shadow database and is the standard production-safe apply path.

datasource db {
  provider = "postgresql"
  url      = env("PRODUCTS_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// SentinelPOS (Sp) — Loss Prevention & Statistical Anomaly Engine
// Source: product-catalog/SentinelPOS.html §3
// ============================================================================

enum SpEventType {
  SALE
  POST_VOID
  LINE_VOID
  RETURN
  MANUAL_DISCOUNT
  PRICE_OVERRIDE
  DRAWER_KICK_NO_SALE
}

enum SpSeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SpIncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_DISMISSED
  RESOLVED_CONFIRMED_LOSS
}

model SpTenant {
  id        String          @id @default(uuid())
  slug      String          @unique
  name      String
  stores    SpStoreLocation[]
  createdAt DateTime        @default(now())
}

model SpStoreLocation {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    SpTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  cashiers  SpCashier[]
  events    SpPosEvent[]
  incidents SpIncident[]
  createdAt DateTime     @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

model SpCashier {
  id              String          @id @default(uuid())
  tenantId        String
  storeLocationId String
  storeLocation   SpStoreLocation @relation(fields: [storeLocationId], references: [id], onDelete: Cascade)
  employeeNumber  String
  name            String
  events          SpPosEvent[]
  incidents       SpIncident[]
  createdAt       DateTime        @default(now())

  @@unique([storeLocationId, employeeNumber])
  @@index([tenantId, storeLocationId])
}

model SpPosEvent {
  id              String          @id @default(uuid())
  tenantId        String
  storeLocationId String
  storeLocation   SpStoreLocation @relation(fields: [storeLocationId], references: [id], onDelete: Cascade)
  cashierId       String
  cashier         SpCashier       @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  registerId      String
  terminalEventId String
  idempotencyHash String          @unique
  eventType       SpEventType
  ticketNumber    String?
  amount          Decimal         @default(0.00) @db.Decimal(12, 4)
  rawPayload      Json
  occurredAt      DateTime
  createdAt       DateTime        @default(now())
  incidentId      String?
  incident        SpIncident?     @relation(fields: [incidentId], references: [id])

  @@index([tenantId, storeLocationId, occurredAt])
  @@index([cashierId, eventType, occurredAt])
}

model SpIncident {
  id               String           @id @default(uuid())
  tenantId         String
  incidentCode     String           @unique
  storeLocationId  String
  storeLocation    SpStoreLocation  @relation(fields: [storeLocationId], references: [id], onDelete: Cascade)
  cashierId        String
  cashier          SpCashier        @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  severity         SpSeverityLevel  @default(MEDIUM)
  status           SpIncidentStatus @default(OPEN)
  title            String
  description      String
  flaggedAmount    Decimal          @default(0.00) @db.Decimal(12, 4)
  zScore           Float            @default(0.0)
  evidenceVaultUri String?
  events           SpPosEvent[]
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?
  resolutionNotes  String?

  @@index([tenantId, status, severity])
}
